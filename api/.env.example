# Copia para `.env`. A API carrega `api/.env` ao arrancar (ver `src/index.ts`).

# Obrigatório em produção / MCP exposto: chave partilhada só com o servidor MCP.
# Header: X-Api-Key: <valor>  ou  Authorization: Bearer <valor>
# Se ficar vazio, a API aceita pedidos sem chave (apenas desenvolvimento local).
MCP_API_KEY=

# Host/porta (Fastify)
API_HOST=0.0.0.0
API_PORT=8080

# PostgreSQL raw_data (schema surveys). Necessário para GET /v1/surveys?session_id=…
# NODE_ENV=dev desativa SSL no cliente; noutros valores usa SSL com rejectUnauthorized: false.
NODE_ENV=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_POOL_MAX=10

# Opcional — base de dados "metrics" (ex.: testers_session_information) para POST /v1/sessions/inspect.
# Se vazio, a linha "testers_session_information (processed)" fica a zero para cada sessão.
METRICS_DB_HOST=
METRICS_DB_PORT=5432
METRICS_DB_USER=
METRICS_DB_PASSWORD=
METRICS_DB_NAME=
